{
  "expo": {
    "name": "velosdrop-customer",
    "slug": "velosdrop-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "velosdropcustomer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velosdrop.customer",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to find nearby delivery points and track your deliveries.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to provide real-time delivery tracking.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of packages and update your profile picture.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload profile pictures and package photos.",
        "NSUserNotificationsUsageDescription": "This app uses notifications to inform you about messages and delivery updates.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBY8xIYWFGSB9EMjm-K705GwDRiS305-m4"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.jpg",
        "backgroundColor": "#000000"
      },
      "package": "com.velosdrop.customer",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBY8xIYWFGSB9EMjm-K705GwDRiS305-m4"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://maven.google.com/"
            ]
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "androidClientId": "197377244964-84nlmi56o2m63lipip1ulkra4lcksrm6.apps.googleusercontent.com",
          "iosClientId": "dummy-ios-client-id-for-android-only",
          "iosUrlScheme": "com.googleusercontent.apps.dummy-ios-client-id",
          "webClientId": "197377244964-402g6igdhcppjm0ro4v1l4hteo3b5jvm.apps.googleusercontent.com",
          "offlineAccess": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to open the camera"
        }
      ],
      [
        "expo-file-system",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7c3aed",
          "sounds": [
            "./assets/sounds/notesound.mp3"
          ],
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "EXPO_PUBLIC_API_URL": "https://velosdrop.com",
